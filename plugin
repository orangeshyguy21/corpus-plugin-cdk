#!/usr/bin/env bash
# cdk-regtest — corpus.environment/1 adapter. stdout is protocol-only NDJSON.
set -uo pipefail

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ARENA="$PLUGIN_DIR/arena.sh"
CONF="$PLUGIN_DIR/config.toml"
ORACLES_DIR="$PLUGIN_DIR/oracles"
EXEC_TIMEOUT_SECS="${CORPUS_EXEC_TIMEOUT_SECS:-90}"
ORACLE_TIMEOUT_SECS="${CORPUS_ORACLE_TIMEOUT_SECS:-90}"
AGENT_IMAGE="corpus-cdk-agent:0.3.7"

reply_ok() { printf '{"id":%s,"ok":true,"result":%s}\n' "$1" "$2"; }
reply_error() {
    jq -nc --argjson id "$1" --arg code "$2" --arg message "$3" \
        --argjson retryable "${4:-false}" \
        '{id:$id,ok:false,error:{code:$code,message:$message,retryable:$retryable}}'
}
progress() {
    jq -nc --argjson id "$1" --arg phase "$2" --arg message "$3" \
        --argjson completed "$4" --argjson total "$5" \
        '{id:$id,event:"progress",phase:$phase,message:$message,completed:$completed,total:$total}'
}

config_get() {
    awk -v section="$1" -v key="$2" '
        function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
        /^\[[^]]+\]/ { cur=$0; gsub(/\[|\]|[ \t]/, "", cur); next }
        cur == section {
            line=$0; sub(/[ \t]*#.*$/, "", line)
            if (index(line, "=") == 0) next
            if (trim(substr(line,1,index(line,"=")-1)) == key) {
                val=trim(substr(line,index(line,"=")+1)); gsub(/^"|"$/, "", val)
                print val; exit
            }
        }
    ' "$CONF"
}
url_port() {
    local value="${1#*://}"; value="${value%%/*}"
    local port="${value##*:}"; [ "$port" = "$value" ] && port=80
    printf '%s' "$port"
}
safe_name() {
    case "$1" in ""|*[!a-zA-Z0-9._+-]*|*..*) return 1 ;; esac
    printf '%s' "$1"
}
hash12() {
    if command -v shasum >/dev/null 2>&1; then
        printf '%s' "$1" | shasum -a 256 | awk '{print substr($1,1,12)}'
    else
        printf '%s' "$1" | sha256sum | awk '{print substr($1,1,12)}'
    fi
}
sha256() {
    if command -v shasum >/dev/null 2>&1; then
        shasum -a 256 | awk '{print $1}'
    else
        sha256sum | awk '{print $1}'
    fi
}
atomic_json() {
    local path="$1" value="$2" tmp
    tmp="$path.tmp.$$"
    mkdir -p "$(dirname "$path")"
    printf '%s\n' "$value" >"$tmp" && mv "$tmp" "$path"
}
operation_file() {
    local key; key="$(printf '%s' "$1" | tr -c 'a-zA-Z0-9._+-' '_')"
    printf '%s/operations/%s.json' "$STATE_DIR" "$key"
}
operation_success() {
    atomic_json "$(operation_file "$1")" \
        "$(jq -nc --arg key "$1" --argjson result "$2" '{idempotency_key:$key,state:"succeeded",result:$result}')"
}
operation_failure() {
    atomic_json "$(operation_file "$1")" \
        "$(jq -nc --arg key "$1" --arg code "$2" --arg message "$3" --argjson retryable "$4" \
            '{idempotency_key:$key,state:"failed",error:{code:$code,message:$message,retryable:$retryable}}')"
}

load_lifecycle_context() {
    STATE_DIR="$(jq -r '.state_dir // ""' <<<"$1")"
    SOURCE_CACHE="$(jq -r '.source_cache // ""' <<<"$1")"
    SOURCES_JSON="$(jq -c '.sources // []' <<<"$1")"
    [ -n "$STATE_DIR" ] && [ "${STATE_DIR#/}" != "$STATE_DIR" ] || return 1
    TOOLS_DIR="$STATE_DIR/tools"
    BACKBONE_DIR="$STATE_DIR/backbone"
    BACKBONE_RECORD="$STATE_DIR/backbone.json"
    mkdir -p "$STATE_DIR/operations"
}
load_session_context() {
    local params="$1" suffix
    SESSION_ID="$(safe_name "$(jq -r '.session_id // ""' <<<"$params")")" || return 1
    STATE_DIR="$(jq -r '.state_dir // ""' <<<"$params")"
    SOURCES_JSON="$(jq -c '.sources // []' <<<"$params")"
    [ -n "$STATE_DIR" ] && [ "${STATE_DIR#/}" != "$STATE_DIR" ] || return 1
    if [ -f "$STATE_DIR/session.json" ] && [ "$(jq -r '.session_id // ""' "$STATE_DIR/session.json")" = "$SESSION_ID" ]; then
        SOURCES_JSON="$(jq -c '.sources // []' "$STATE_DIR/session.json")"
    fi
    suffix="$(hash12 "$SESSION_ID")"
    RUNTIME_DIR="$(dirname "$(dirname "$STATE_DIR")")"
    TOOLS_DIR="$RUNTIME_DIR/tools"
    FAUCET="$RUNTIME_DIR/corpus-faucet"; [ -x "$FAUCET" ] || FAUCET="$PLUGIN_DIR/faucet.sh"
    EVIDENCE_DIR="$STATE_DIR/evidence"
    ARENA_NETWORK="corpus-cdk-$suffix"
    EGRESS_NETWORK="corpus-cdk-egress-$suffix"
    GATEWAY_NAME="corpus-cdk-gateway-$suffix"
    SANDBOX_NAME="corpus-cdk-sandbox-$suffix"
    mkdir -p "$STATE_DIR/operations" "$EVIDENCE_DIR"
}
targets_ready() {
    curl -sf --max-time 3 "$(config_get target mint_url)/v1/info" >/dev/null 2>&1 &&
        curl -sf --max-time 3 "$(config_get target mint_url_2)/v1/info" >/dev/null 2>&1
}
external_work_dir() {
    local env_file=/tmp/cdk_regtest_env line
    [ -f "$env_file" ] || return 0
    line="$(grep -E '^(export[[:space:]]+)?CDK_ITESTS_DIR=' "$env_file" | tail -1 || true)"
    line="${line#export }"; line="${line#CDK_ITESTS_DIR=}"; line="${line%\"}"; line="${line#\"}"; line="${line%\'}"; line="${line#\'}"
    printf '%s' "$line"
}
backbone_work_dir() {
    if [ -f "$RUNTIME_DIR/backbone.json" ]; then
        jq -r '.work_dir // ""' "$RUNTIME_DIR/backbone.json"
    else
        external_work_dir
    fi
}
start_backbone() {
    local cdk_source="$1" pid log mint_addr mint_port_1 mint_port_2 waited=0
    command -v nix >/dev/null 2>&1 || { printf '%s' "nix is required to start the pinned CDK regtest"; return 1; }
    mkdir -p "$BACKBONE_DIR"
    log="$STATE_DIR/backbone.log"
    mint_addr="127.0.0.1"; mint_port_1="$(url_port "$(config_get target mint_url)")"; mint_port_2="$(url_port "$(config_get target mint_url_2)")"
    nohup nix run "$cdk_source#start-regtest-mints" -- \
        --enable-logging sqlite "$BACKBONE_DIR" "$mint_addr" "$mint_port_1" "$mint_port_2" \
        >"$log" 2>&1 </dev/null &
    pid=$!
    atomic_json "$BACKBONE_RECORD" "$(jq -nc --argjson pid "$pid" --arg work_dir "$BACKBONE_DIR" --arg log "$log" '{ownership:"plugin",pid:$pid,work_dir:$work_dir,log:$log,state:"starting"}')"
    while [ "$waited" -lt 300 ]; do
        if targets_ready && [ -f "$BACKBONE_DIR/.ready" ]; then
            atomic_json "$BACKBONE_RECORD" "$(jq '.state="ready"' "$BACKBONE_RECORD")"
            return 0
        fi
        if ! kill -0 "$pid" 2>/dev/null; then
            printf 'CDK regtest exited during startup; see %s' "$log"
            return 1
        fi
        sleep 1; waited=$((waited+1))
    done
    kill -TERM "$pid" 2>/dev/null || true
    printf 'CDK regtest did not become ready within 300 seconds; see %s' "$log"
    return 1
}
stop_backbone() {
    local pid command waited=0
    [ -f "$BACKBONE_RECORD" ] || return 0
    [ "$(jq -r '.ownership // ""' "$BACKBONE_RECORD")" = plugin ] || { rm -f "$BACKBONE_RECORD"; return 0; }
    pid="$(jq -r '.pid // ""' "$BACKBONE_RECORD")"
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    if kill -0 "$pid" 2>/dev/null; then
        command="$(ps -p "$pid" -o command= 2>/dev/null || true)"
        case "$command" in *"$BACKBONE_DIR"*) ;; *) return 1 ;; esac
        kill -TERM "$pid" 2>/dev/null || true
        while kill -0 "$pid" 2>/dev/null && [ "$waited" -lt 30 ]; do sleep 1; waited=$((waited+1)); done
        kill -KILL "$pid" 2>/dev/null || true
    fi
    rm -f "$BACKBONE_RECORD"
}
run_arena() {
    CORPUS_AGENT_IMAGE="$AGENT_IMAGE" CORPUS_ARENA_NETWORK="$ARENA_NETWORK" \
    CORPUS_EGRESS_NETWORK="$EGRESS_NETWORK" CORPUS_GATEWAY_NAME="$GATEWAY_NAME" \
    CORPUS_SANDBOX_NAME="$SANDBOX_NAME" CORPUS_EVIDENCE_DIR="$EVIDENCE_DIR" \
    CORPUS_TOOLS_DIR="$TOOLS_DIR" CORPUS_SOURCES_JSON="$SOURCES_JSON" "$ARENA" "$@"
}
run_with_timeout() {
    local secs="$1" outfile="$2"; shift 2
    if command -v timeout >/dev/null 2>&1; then timeout "$secs" "$@" >"$outfile" 2>&1; return $?; fi
    if command -v gtimeout >/dev/null 2>&1; then gtimeout "$secs" "$@" >"$outfile" 2>&1; return $?; fi
    local marker="$outfile.killed" cmd_pid watch_pid rc; rm -f "$marker"
    "$@" >"$outfile" 2>&1 & cmd_pid=$!
    ( sleep "$secs"; if kill -0 "$cmd_pid" 2>/dev/null; then : >"$marker"; kill -TERM "$cmd_pid" 2>/dev/null; sleep 2; kill -KILL "$cmd_pid" 2>/dev/null; fi ) >/dev/null 2>&1 & watch_pid=$!
    wait "$cmd_pid" 2>/dev/null; rc=$?; kill "$watch_pid" 2>/dev/null; wait "$watch_pid" 2>/dev/null
    if [ -f "$marker" ]; then rm -f "$marker"; return 124; fi; return "$rc"
}
docker_error() {
    if ! command -v docker >/dev/null 2>&1; then printf '%s' dependency_missing
    elif docker info >/dev/null 2>&1; then printf '%s' ready
    elif [ -S "$HOME/.docker/run/docker.sock" ] && [ ! -r "$HOME/.docker/run/docker.sock" ]; then printf '%s' permission_denied
    else printf '%s' daemon_unavailable; fi
}
doctor_result() {
    local state="$1" mint1 mint2 ready=true image_digest="" ownership="absent"; local notes=()
    if [ "$(docker_error)" != ready ]; then ready=false; notes+=("docker $(docker_error)"); fi
    docker image inspect "$AGENT_IMAGE" >/dev/null 2>&1 || { ready=false; notes+=("attacker image missing"); }
    [ -x "$state/tools/cdk-cli" ] || { ready=false; notes+=("cdk-cli missing"); }
    [ -x "$state/corpus-faucet" ] || { ready=false; notes+=("corpus-faucet missing"); }
    mint1="$(config_get target mint_url)"; mint2="$(config_get target mint_url_2)"
    curl -sf --max-time 3 "$mint1/v1/info" >/dev/null 2>&1 || { ready=false; notes+=("mint-1 unreachable"); }
    curl -sf --max-time 3 "$mint2/v1/info" >/dev/null 2>&1 || { ready=false; notes+=("mint-2 unreachable"); }
    [ -f "$state/backbone.json" ] && ownership="$(jq -r '.ownership // "unknown"' "$state/backbone.json")"
    image_digest="$(docker image inspect "$AGENT_IMAGE" --format '{{.Id}}' 2>/dev/null || true)"
    local joined=ready; [ "${#notes[@]}" -gt 0 ] && joined="$(IFS=', '; echo "${notes[*]}")"
    jq -nc --argjson ready "$ready" --arg notes "$joined" --arg image_digest "$image_digest" --arg ownership "$ownership" \
        '{ready:$ready,notes:$notes,docker:{required:true},image_digest:$image_digest,backbone:{ownership:$ownership}}'
}

handle_setup() {
    local id="$1" params="$2" key result cdk_source out
    load_lifecycle_context "$params" || { reply_error "$id" invalid_context "setup requires an absolute state_dir" false; return; }
    key="$(jq -r '.idempotency_key // "setup:cdk-regtest:0.3.7"' <<<"$params")"
    progress "$id" dependency_fetch "default source locks verified" 1 5
    cdk_source="$(jq -r '.sources[]? | select(.id=="cdk") | .host_path' <<<"$params" | head -1)"
    [ -d "$cdk_source/.git" ] || { operation_failure "$key" source_missing "CDK source was not materialized by Corpus" true; reply_error "$id" source_missing "CDK source was not materialized by Corpus" true; return; }
    progress "$id" image_build "building attacker image" 2 5
    if ! out="$(CORPUS_AGENT_IMAGE="$AGENT_IMAGE" "$ARENA" build 2>&1)"; then operation_failure "$key" image_build_failed "$out" true; reply_error "$id" image_build_failed "$out" true; return; fi
    progress "$id" tool_build "building cdk-cli and host faucet" 3 5; mkdir -p "$TOOLS_DIR"
    if [ ! -x "$TOOLS_DIR/cdk-cli" ]; then
        if ! out="$(CORPUS_CDK_REPO="$cdk_source" CORPUS_TOOLS_DIR="$TOOLS_DIR" "$PLUGIN_DIR/tools/build-tools.sh" 2>&1)"; then operation_failure "$key" tool_build_failed "$out" true; reply_error "$id" tool_build_failed "$out" true; return; fi
    fi
    if [ ! -x "$STATE_DIR/corpus-faucet" ]; then
        if ! CARGO_TARGET_DIR="$STATE_DIR/faucet-target" cargo build --manifest-path "$PLUGIN_DIR/faucet-src/Cargo.toml" --release >/dev/null 2>&1; then operation_failure "$key" faucet_build_failed "could not build corpus-faucet" true; reply_error "$id" faucet_build_failed "could not build corpus-faucet" true; return; fi
        cp "$STATE_DIR/faucet-target/release/corpus-faucet" "$STATE_DIR/corpus-faucet"; chmod 755 "$STATE_DIR/corpus-faucet"
    fi
    progress "$id" target_start "starting pinned CDK regtest when absent" 4 5
    if targets_ready; then
        if [ ! -f "$BACKBONE_RECORD" ]; then
            atomic_json "$BACKBONE_RECORD" "$(jq -nc --arg work_dir "$(external_work_dir)" '{ownership:"adopted",work_dir:$work_dir,state:"ready"}')"
        fi
    elif ! out="$(start_backbone "$cdk_source")"; then
        operation_failure "$key" target_start_failed "$out" true; reply_error "$id" target_start_failed "$out" true; return
    fi
    progress "$id" verification "checking Docker, tools, targets, and oracle prerequisites" 5 5
    result="$(doctor_result "$STATE_DIR")"
    if [ "$(jq -r '.ready' <<<"$result")" != true ]; then operation_failure "$key" verification_failed "$(jq -r '.notes' <<<"$result")" true; reply_error "$id" verification_failed "$(jq -r '.notes' <<<"$result")" true; return; fi
    operation_success "$key" "$result"; reply_ok "$id" "$result"
}
handle_session_open() {
    local id="$1" params="$2" key out image_digest lock result
    load_session_context "$params" || { reply_error "$id" invalid_context "session_open requires session_id and absolute state_dir" false; return; }
    key="$(jq -r '.idempotency_key // empty' <<<"$params")"
    [ "$(jq 'length' <<<"$SOURCES_JSON")" -gt 0 ] || { reply_error "$id" source_missing "session has no resolved sources" false; return; }
    if ! out="$(run_arena up 2>&1)"; then [ -n "$key" ] && operation_failure "$key" session_open_failed "$out" true; reply_error "$id" session_open_failed "$out" true; return; fi
    image_digest="$(docker image inspect "$AGENT_IMAGE" --format '{{.Id}}' 2>/dev/null || true)"
    lock="sha256:$(printf '%s' "$(cat "$PLUGIN_DIR/environment.lock")|$SOURCES_JSON|$image_digest" | sha256)"
    result="$(jq -nc --arg environment_lock "$lock" --arg image_digest "$image_digest" '{ready:true,environment_lock:$environment_lock,image_digest:$image_digest}')"
    atomic_json "$STATE_DIR/session.json" "$(jq -nc --arg session_id "$SESSION_ID" --arg network "$ARENA_NETWORK" --arg egress_network "$EGRESS_NETWORK" --arg gateway "$GATEWAY_NAME" --arg sandbox "$SANDBOX_NAME" --arg image_digest "$image_digest" --argjson sources "$SOURCES_JSON" '{session_id:$session_id,state:"ready",network:$network,egress_network:$egress_network,gateway:$gateway,sandbox:$sandbox,image_digest:$image_digest,sources:$sources}')"
    [ -n "$key" ] && operation_success "$key" "$result"; reply_ok "$id" "$result"
}
ensure_ready_session() {
    load_session_context "$1" || return 1
    [ -f "$STATE_DIR/session.json" ] && [ "$(jq -r '.session_id' "$STATE_DIR/session.json")" = "$SESSION_ID" ] && [ "$(jq -r '.state' "$STATE_DIR/session.json")" = ready ]
}

handle() {
    local id="$1" method="$2" params="$3"
    case "$method" in
        hello) reply_ok "$id" '{"protocol":"corpus.environment/1","capabilities":["sessions","sandbox.exec","faucet.bolt11","wallet.fund","oracle.run","lifecycle.setup"]}' ;;
        operation_status)
            load_lifecycle_context "$params" || { reply_error "$id" invalid_context "operation_status requires state_dir" false; return; }
            local op_key op_file op_value; op_key="$(jq -r '.idempotency_key // ""' <<<"$params")"; op_file="$(operation_file "$op_key")"
            if [ -f "$op_file" ]; then
                op_value="$(cat "$op_file")"
                if [[ "$op_key" == setup:* ]] && [ "$(jq -r '.state' <<<"$op_value")" = succeeded ] && [ "$(doctor_result "$STATE_DIR" | jq -r '.ready')" != true ]; then
                    reply_ok "$id" "$(jq -nc --arg key "$op_key" '{idempotency_key:$key,state:"unknown"}')"
                else
                    reply_ok "$id" "$op_value"
                fi
            else reply_ok "$id" "$(jq -nc --arg key "$op_key" '{idempotency_key:$key,state:"unknown"}')"; fi ;;
        setup) handle_setup "$id" "$params" ;;
        doctor|status)
            load_lifecycle_context "$params" || { reply_error "$id" invalid_context "$method requires state_dir" false; return; }
            local health; health="$(doctor_result "$STATE_DIR")"
            if [ "$(jq -r '.ready' <<<"$health")" = true ]; then reply_ok "$id" "$health"; else reply_error "$id" unhealthy "$(jq -r '.notes' <<<"$health")" true; fi ;;
        stop)
            load_lifecycle_context "$params" || { reply_error "$id" invalid_context "stop requires state_dir" false; return; }
            local active=0 record gateway sandbox
            for record in "$STATE_DIR"/state/*/session.json; do [ -f "$record" ] || continue; [ "$(jq -r '.state' "$record")" = ready ] || continue; gateway="$(jq -r '.gateway' "$record")"; sandbox="$(jq -r '.sandbox' "$record")"; if docker inspect "$gateway" >/dev/null 2>&1 || docker inspect "$sandbox" >/dev/null 2>&1; then active=$((active+1)); fi; done
            if [ "$active" -gt 0 ]; then reply_error "$id" sessions_active "$active environment session(s) are still active" true
            elif stop_backbone; then reply_ok "$id" '{"stopped":true}'
            else reply_error "$id" cleanup_failed "could not stop the plugin-owned CDK regtest" true; fi ;;
        session_open) handle_session_open "$id" "$params" ;;
        session_probe)
            ensure_ready_session "$params" || { reply_error "$id" session_not_ready "session record is absent or not ready" true; return; }
            local ready=true notes="session ready" version=""; docker inspect "$GATEWAY_NAME" --format '{{.State.Running}}' 2>/dev/null | grep -qx true || { ready=false; notes="session gateway is not running"; }
            version="$(curl -sf --max-time 3 "$(config_get target mint_url)/v1/info" 2>/dev/null | jq -r '.version // ""' | sed 's#^cdk-mintd/##')"
            reply_ok "$id" "$(jq -nc --argjson ready "$ready" --arg notes "$notes" --arg running_version "$version" '{ready:$ready,notes:$notes,running_version:(if $running_version=="" then null else $running_version end)}')" ;;
        describe)
            ensure_ready_session "$params" || { reply_error "$id" session_not_ready "session record is absent or not ready" true; return; }
            local m1 m2 version image_digest targets cdk_sha
            m1="http://$GATEWAY_NAME:$(url_port "$(config_get target mint_url)")"; m2="http://$GATEWAY_NAME:$(url_port "$(config_get target mint_url_2)")"
            version="$(curl -sf --max-time 3 "$(config_get target mint_url)/v1/info" 2>/dev/null | jq -r '.version // ""')"; image_digest="$(jq -r '.image_digest' "$STATE_DIR/session.json")"; cdk_sha="$(jq -r '.[] | select(.id=="cdk") | .sha' <<<"$SOURCES_JSON")"
            targets="$(jq -nc --arg a "$m1" --arg b "$m2" --arg sha "$cdk_sha" --arg version "$version" --arg image "$image_digest" '[{id:"mint-1",kind:"cashu-mint",url:$a,source_id:"cdk",source_sha:$sha,reported_version:$version,image_digest:$image},{id:"mint-2",kind:"cashu-mint",url:$b,source_id:"cdk",source_sha:$sha,reported_version:$version,image_digest:$image}]')"
            reply_ok "$id" "$(jq -nc --argjson targets "$targets" --arg image "$image_digest" '{targets:$targets,tools:[{id:"cdk-cli",description:"session-scoped Cashu attacker wallet",path:"/opt/tools/cdk-cli"}],limits:{max_payment_sats:100000},provenance:{image_digest:$image}}')" ;;
        sandbox_exec)
            ensure_ready_session "$params" || { reply_error "$id" session_not_ready "session record is absent or not ready" true; return; }
            local command out rc; command="$(jq -r '.command // ""' <<<"$params")"; [ -n "$command" ] || { reply_error "$id" invalid_args "missing command" false; return; }
            if [ "$(docker inspect -f '{{.State.Running}}' "$SANDBOX_NAME" 2>/dev/null)" != true ]; then if ! out="$(run_arena agent testing --detach -- sleep infinity 2>&1)"; then reply_error "$id" sandbox_start_failed "$out" true; return; fi; fi
            out="$(docker exec "$SANDBOX_NAME" timeout "$EXEC_TIMEOUT_SECS" bash -c "$command" 2>&1)"; rc=$?; reply_ok "$id" "$(jq -nc --arg output "$out" --argjson exit_code "$rc" '{output:$output,exit_code:$exit_code}')" ;;
        oracles)
            ensure_ready_session "$params" || { reply_error "$id" session_not_ready "session record is absent or not ready" true; return; }
            local items='[]' file name desc; for file in "$ORACLES_DIR"/[0-9]*.sh; do [ -f "$file" ] || continue; name="$(basename "$file" .sh)"; desc="$(grep -m1 '^# Oracle' "$file" | sed 's/^# //')"; items="$(jq -nc --argjson items "$items" --arg name "$name" --arg description "$desc" '$items+[{name:$name,description:$description}]')"; done; reply_ok "$id" "$items" ;;
        call_oracle)
            ensure_ready_session "$params" || { reply_error "$id" session_not_ready "session record is absent or not ready" true; return; }
            local name script outfile out rc verdict; name="$(safe_name "$(jq -r '.name // ""' <<<"$params")")" || { reply_error "$id" invalid_args "bad oracle name" false; return; }; script="$ORACLES_DIR/$name.sh"; [ -f "$script" ] || { reply_error "$id" unknown_oracle "unknown oracle: $name" false; return; }
            outfile="$(mktemp "${TMPDIR:-/tmp}/corpus-cdk-oracle.XXXXXX")"; CDK_ITESTS_DIR="$(backbone_work_dir)" MINT_URL="$(config_get target mint_url)" MINT_URL_2="$(config_get target mint_url_2)" EVIDENCE_DIR="$EVIDENCE_DIR" run_with_timeout "$ORACLE_TIMEOUT_SECS" "$outfile" bash "$script"; rc=$?; out="$(cat "$outfile" 2>/dev/null)"; rm -f "$outfile"; case "$rc" in 0) verdict=hold ;; 1) verdict=violated ;; *) verdict=inconclusive ;; esac; [ "$rc" -ne 124 ] || out="oracle timed out after ${ORACLE_TIMEOUT_SECS}s; $out"; reply_ok "$id" "$(jq -nc --arg verdict "$verdict" --arg log "$out" '{verdict:$verdict,log:$log}')" ;;
        faucet)
            ensure_ready_session "$params" || { reply_error "$id" session_not_ready "session record is absent or not ready" true; return; }
            local op invoice amount memo max out err rc paid tmp_stdout tmp_stderr; op="$(jq -r '.op // ""' <<<"$params")"; invoice="$(jq -r '.call.invoice // ""' <<<"$params")"; amount="$(jq -r '.call.amount_sat // ""' <<<"$params")"; memo="$(jq -r '.call.memo // ""' <<<"$params")"; max="$(config_get faucet max_payment_sats)"; tmp_stdout="$(mktemp)"; tmp_stderr="$(mktemp)"; paid=""
            case "$op" in pay) CDK_ITESTS_DIR="$(backbone_work_dir)" CORPUS_FAUCET_MAX_SATS="$max" "$FAUCET" pay "$invoice" >"$tmp_stdout" 2>"$tmp_stderr"; rc=$? ;; invoice) CDK_ITESTS_DIR="$(backbone_work_dir)" CORPUS_FAUCET_MAX_SATS="$max" "$FAUCET" invoice "$amount" "$memo" >"$tmp_stdout" 2>"$tmp_stderr"; rc=$? ;; balance) CDK_ITESTS_DIR="$(backbone_work_dir)" "$FAUCET" balance >"$tmp_stdout" 2>"$tmp_stderr"; rc=$? ;; *) rm -f "$tmp_stdout" "$tmp_stderr"; reply_error "$id" invalid_args "unknown faucet op: $op" false; return ;; esac
            out="$(cat "$tmp_stdout")"; err="$(cat "$tmp_stderr")"; rm -f "$tmp_stdout" "$tmp_stderr"; [ "$rc" -eq 0 ] || { reply_error "$id" faucet_failed "${err:-faucet operation failed}" true; return; }; paid="$(grep -o 'PAID_SATS=[0-9]*' <<<"$out" | cut -d= -f2 | head -1)"; reply_ok "$id" "$(jq -nc --arg text "$out" --arg paid "$paid" '{text:$text,paid_sats:(if $paid=="" then null else ($paid|tonumber) end)}')" ;;
        wallet_fund)
            ensure_ready_session "$params" || { reply_error "$id" session_not_ready "session record is absent or not ready" true; return; }
            local amount target_id target work_dir cli quote invoice quote_id pay claim balance; amount="$(jq -r '.amount_sat // ""' <<<"$params")"; target_id="$(jq -r '.target_id // "mint-1"' <<<"$params")"; case "$amount" in ""|*[!0-9]*) reply_error "$id" invalid_args "amount_sat must be numeric" false; return ;; esac; case "$target_id" in mint-1) target="http://$GATEWAY_NAME:$(url_port "$(config_get target mint_url)")" ;; mint-2) target="http://$GATEWAY_NAME:$(url_port "$(config_get target mint_url_2)")" ;; *) reply_error "$id" invalid_args "unknown target_id: $target_id" false; return ;; esac
            work_dir="/tmp/wallet-$(hash12 "$SESSION_ID-$target_id")"; cli="/opt/tools/cdk-cli -n -w $work_dir"; if [ "$(docker inspect -f '{{.State.Running}}' "$SANDBOX_NAME" 2>/dev/null)" != true ]; then run_arena agent testing --detach -- sleep infinity >/dev/null 2>&1 || { reply_error "$id" sandbox_start_failed "could not start attacker sandbox" true; return; }; fi
            quote="$(docker exec "$SANDBOX_NAME" timeout "$EXEC_TIMEOUT_SECS" bash -c "rm -rf '$work_dir' && $cli mint '$target' '$amount' --wait-duration 2" 2>&1 || true)"; invoice="$(grep -o 'lnbcrt[^[:space:]]*' <<<"$quote" | head -1)"; quote_id="$(grep -o 'id=[^,[:space:]]*' <<<"$quote" | head -1 | cut -d= -f2)"; [ -n "$invoice" ] && [ -n "$quote_id" ] || { reply_error "$id" quote_failed "mint quote output missing invoice or id: $quote" true; return; }; pay="$(CDK_ITESTS_DIR="$(backbone_work_dir)" CORPUS_FAUCET_MAX_SATS="$(config_get faucet max_payment_sats)" "$FAUCET" pay "$invoice" 2>&1)" || { reply_error "$id" faucet_failed "$pay" true; return; }; claim="$(docker exec "$SANDBOX_NAME" timeout "$EXEC_TIMEOUT_SECS" bash -c "$cli mint '$target' -q '$quote_id' --wait-duration 15" 2>&1)" || { reply_error "$id" claim_failed "$claim" true; return; }; balance="$(docker exec "$SANDBOX_NAME" timeout "$EXEC_TIMEOUT_SECS" bash -c "$cli balance" 2>&1)" || { reply_error "$id" balance_failed "$balance" true; return; }; reply_ok "$id" "$(jq -nc --argjson amount_sat "$amount" --arg target "$target" --arg claim "$claim" --arg balance "$balance" '{funded:true,amount_sat:$amount_sat,target:$target,claim:$claim,balance:$balance}')" ;;
        session_close)
            load_session_context "$params" || { reply_error "$id" invalid_context "session_close requires session context" false; return; }
            local key out result; key="$(jq -r '.idempotency_key // empty' <<<"$params")"; if ! out="$(run_arena down 2>&1)"; then [ -n "$key" ] && operation_failure "$key" cleanup_failed "$out" true; reply_error "$id" cleanup_failed "$out" true; return; fi; if [ -f "$STATE_DIR/session.json" ]; then atomic_json "$STATE_DIR/session.json" "$(jq '.state="closed"' "$STATE_DIR/session.json")"; fi; result='{"closed":true}'; [ -n "$key" ] && operation_success "$key" "$result"; reply_ok "$id" "$result" ;;
        *) reply_error "$id" unknown_method "unknown method: $method" false ;;
    esac
}

while IFS= read -r line; do
    id="$(jq -r '.id // 0' <<<"$line" 2>/dev/null)" || id=0
    method="$(jq -r '.method // ""' <<<"$line" 2>/dev/null)" || method=""
    params="$(jq -c '.params // {}' <<<"$line" 2>/dev/null)" || params='{}'
    handle "$id" "$method" "$params"
done
